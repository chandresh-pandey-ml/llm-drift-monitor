# LLM Drift Monitor - local secrets template
# Copy this file to .env and fill in real values:
#   cp .env.example .env
# NEVER commit .env or real API keys to version control.

# --- Grok (XAI) ---
# Docs: https://docs.x.ai/
# OpenAI-compatible endpoint: https://api.x.ai/v1
# Latest model: grok-4.7
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
XAI_MODEL=grok-4.7

# --- Groq ---
# OpenAI-compatible endpoint: https://api.groq.com/openai/v1
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile

# --- Gemini (Google AI) ---
# Docs: https://ai.google.dev/gemini-api/docs
# OpenAI-compatible endpoint: https://generativelanguage.googleapis.com/v1beta/openai/
# Latest Flash model: gemini-3.8-flash (flagship: gemini-4-argon)
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_MODEL=gemini-3.8-flash
