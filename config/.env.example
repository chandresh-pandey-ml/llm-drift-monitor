# LLM Drift Monitor - local secrets template
# Copy this file to .env and fill in real values:
#   cp .env.example .env
# NEVER commit .env or real API keys to version control.

# --- Grok (XAI) ---
# Docs: https://docs.x.ai/
# OpenAI-compatible endpoint: https://api.x.ai/v1
# Latest model: grok-4.7
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
XAI_MODEL=grok-4.7

# --- Groq ---
# OpenAI-compatible endpoint: https://api.groq.com/openai/v1
# Verified model: openai/gpt-oss-20b (a reasoning model; it spends part of
# the max_tokens budget on reasoning before the answer text)
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-20b

# --- Gemini (Google AI) ---
# Docs: https://ai.google.dev/gemini-api/docs
# Verified path: the NATIVE generateContent endpoint (target type: gemini),
# https://generativelanguage.googleapis.com/v1beta; the hosted OpenAI-compatible
# layer below has been observed to 404 for some models.
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_MODEL=gemini-3.1-flash-lite
